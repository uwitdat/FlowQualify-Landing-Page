/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# large video assets (host on CDN/external and use URL in code)
public/videos/*.mp4

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Private client data & reports
*.pdf
VSL4.mp4

# Claude project memory
.claude/

# Development backup files
*.bak
*.pre-conversion

# Development screenshots (working copies)
