<div id="lb-overlay" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
  <div id="lb-wrap">
    <button id="lb-close" aria-label="Close image (Escape)">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img id="lb-img" src="" alt=""><p id="lb-cap"></p>
  </div>
</div>
<script>
(function(){
  var overlay=document.getElementById('lb-overlay'),lbImg=document.getElementById('lb-img'),lbCap=document.getElementById('lb-cap'),pf;
  function open(s,a,c){pf=document.activeElement;lbImg.src=s;lbImg.alt=a;lbCap.textContent=c||'';overlay.classList.add('lb-open');document.body.style.overflow='hidden';document.getElementById('lb-close').focus();}
  function close(){overlay.classList.remove('lb-open');document.body.style.overflow='';if(pf)pf.focus();}
  document.querySelectorAll('.lb-trigger').forEach(function(el){
    el.setAttribute('role','button');el.setAttribute('tabindex','0');el.setAttribute('aria-label','Enlarge screenshot');
    function act(){var img=el.querySelector('img');open(img.src,img.alt,el.dataset.caption||'');}
    el.addEventListener('click',act);el.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();act();}});
  });
  overlay.addEventListener('click',function(e){if(e.target===overlay)close();});
  document.getElementById('lb-close').addEventListener('click',close);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});
})();
</script>
