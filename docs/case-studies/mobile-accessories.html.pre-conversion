<!-- Lightbox overlay -->
<div id="lb-overlay" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
  <div id="lb-wrap">
    <button id="lb-close" aria-label="Close image (Escape)">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img id="lb-img" src="" alt="">
    <p id="lb-cap"></p>
  </div>
</div>

<script>
(function(){
  var overlay = document.getElementById('lb-overlay');
  var lbImg   = document.getElementById('lb-img');
  var lbCap   = document.getElementById('lb-cap');
  var prevFocus;

  function open(src, alt, caption){
    prevFocus = document.activeElement;
    lbImg.src = src; lbImg.alt = alt;
    lbCap.textContent = caption || '';
    overlay.classList.add('lb-open');
    document.body.style.overflow = 'hidden';
    document.getElementById('lb-close').focus();
  }
  function close(){
    overlay.classList.remove('lb-open');
    document.body.style.overflow = '';
    if(prevFocus) prevFocus.focus();
  }

  document.querySelectorAll('.lb-trigger').forEach(function(el){
    el.setAttribute('role','button');
    el.setAttribute('tabindex','0');
    el.setAttribute('aria-label','Enlarge screenshot');
    function activate(){ var img = el.querySelector('img'); open(img.src, img.alt, el.dataset.caption||''); }
    el.addEventListener('click', activate);
    el.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); activate(); } });
  });

  overlay.addEventListener('click', function(e){ if(e.target===overlay) close(); });
  document.getElementById('lb-close').addEventListener('click', close);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });
})();
</script>
